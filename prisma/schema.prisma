// Data model mirrors docs/PROJECT_SPEC.md section 4, which was validated
// against reference/Howell_Restock_Data_Model.xlsx. Keep field names in
// sync with that doc unless the user directs otherwise.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PropertyType {
  STR
  LTR
  HUD_VASH
}

enum PropertySource {
  Hostaway
  Manual
}

enum UserRole {
  Admin
  Field
}

enum NoteCategory {
  RestockIssue
  Repair
  General
}

enum NoteStatus {
  Open
  Resolved
}

enum WorkOrderStatus {
  Open
  Completed
  Archived
}

model Property {
  id                       String         @id @default(cuid())
  name_address             String
  address                  String?
  bedrooms                 Int?
  bathrooms                Float?
  master_door_code         String?
  general_notes            String?
  type                     PropertyType
  unit_count               Int
  assigned_cleaning_team   String?
  restock_frequency_days   Int
  urgent_restock_requested Boolean        @default(false)
  active                   Boolean        @default(true)
  hostaway_listing_id      String?        @unique
  source                   PropertySource @default(Manual)
  assignedTeamMemberId     String?

  parLevels          ParLevel[]
  restockEvents      RestockEvent[]
  notes              Note[]
  assignedUsers      User[]         @relation("AssignedProperties")
  assignedTeamMember TeamMember?    @relation(fields: [assignedTeamMemberId], references: [id])
  workOrders         WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("properties")
}

model Item {
  id                String   @id @default(cuid())
  name              String
  category          String
  unit_of_measure   String
  central_stock_qty Int      @default(0)
  reorder_threshold Int
  reorder_qty       Int
  preferred_vendor  String?
  unit_cost         Decimal  @db.Decimal(10, 2)
  active            Boolean  @default(true)
  // Which room(s) this item is grouped under in the property detail page's
  // par levels table and on work orders (admin + public) - separate from
  // `category` above, which is a general product taxonomy. An item can be
  // in more than one room (e.g. Hand Soap: Kitchen and Bathroom) - there's
  // still only one shared par level/quantity per property though, not one
  // per room it's grouped under. Empty means "Other" in the grouped UI.
  room_groups       String[] @default([])

  parLevels      ParLevel[]
  restockEvents  RestockEvent[]
  workOrderItems WorkOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("items")
}

model ParLevel {
  id          String @id @default(cuid())
  property_id String
  item_id     String
  target_qty  Int

  property Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([property_id, item_id])
  @@map("par_levels")
}

model RestockEvent {
  id             String   @id @default(cuid())
  property_id    String
  item_id        String
  date           DateTime
  qty_delivered  Int
  logged_by      String?
  logged_by_name String?
  urgent_flag    Boolean  @default(false)
  notes          String?

  property     Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  item         Item     @relation(fields: [item_id], references: [id], onDelete: Cascade)
  loggedByUser User?    @relation(fields: [logged_by], references: [id])

  createdAt DateTime @default(now())

  @@map("restock_events")
}

// Repair/issue notes, optionally tied to the work order visit they were
// spotted during (work_order_id) - always tied to a property either way.
// Completing a work order emails any of its notes (with photo links) to
// the service admin - see completeWorkOrderItem in src/lib/workorders.ts.
model Note {
  id            String       @id @default(cuid())
  property_id   String
  work_order_id String?
  date          DateTime
  category      NoteCategory
  description   String
  status        NoteStatus   @default(Open)

  property  Property    @relation(fields: [property_id], references: [id], onDelete: Cascade)
  workOrder WorkOrder?  @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  photos    NotePhoto[]

  createdAt DateTime @default(now())

  @@map("notes")
}

model NotePhoto {
  id      String @id @default(cuid())
  note_id String
  url     String

  note Note @relation(fields: [note_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("note_photos")
}

model TeamMember {
  id     String  @id @default(cuid())
  name   String
  email  String?
  phone  String?
  active Boolean @default(true)

  assignedProperties Property[]
  workOrders         WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// A snapshot task created for one property's upcoming restock visit. Line
// items (WorkOrderItem) copy each item's par level at creation time so the
// work order stays stable even if par levels change later. Reachable either
// by an authenticated admin (/work-orders/[id]) or via share_token, an
// unguessable link sent to the assigned team member with no login required
// (/wo/[token]) - see src/app/wo/[token]/page.tsx.
model WorkOrder {
  id                      String          @id @default(cuid())
  property_id             String
  assigned_team_member_id String?
  share_token             String          @unique
  status                  WorkOrderStatus @default(Open)
  scheduled_for           DateTime?
  sent_at                 DateTime?
  created_by              String?

  property           Property        @relation(fields: [property_id], references: [id], onDelete: Cascade)
  assignedTeamMember TeamMember?     @relation(fields: [assigned_team_member_id], references: [id])
  createdByUser      User?           @relation(fields: [created_by], references: [id])
  items              WorkOrderItem[]
  notes              Note[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("work_orders")
}

model WorkOrderItem {
  id            String    @id @default(cuid())
  work_order_id String
  item_id       String
  qty_needed    Int
  qty_on_site   Int?
  qty_added     Int?
  completed     Boolean   @default(false)
  completedAt   DateTime?

  workOrder WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@map("work_order_items")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  role          UserRole
  password_hash String

  assignedProperties Property[]     @relation("AssignedProperties")
  restockEvents      RestockEvent[]
  createdWorkOrders  WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Singleton row (id is always "hostaway") holding integration credentials
// entered via the Settings page. Not committed anywhere in source - this is
// the DB-backed alternative to the HOSTAWAY_ACCOUNT_ID / HOSTAWAY_API_KEY
// env vars, which still take precedence if set (see src/lib/settings.ts).
model IntegrationSettings {
  id                        String   @id @default("hostaway")
  hostaway_account_id       String?
  hostaway_api_key          String?
  resend_api_key            String?
  resend_from_email         String?
  twilio_account_sid        String?
  twilio_auth_token         String?
  twilio_from_number        String?
  supabase_project_url      String?
  supabase_service_role_key String?
  service_admin_email       String?
  updatedAt                 DateTime @updatedAt

  @@map("integration_settings")
}

// A shareable, no-login URL (/access/[token]) that grants whichever
// sections are listed in `sections` - see src/lib/accessLinks.ts for the
// canonical section list. Deliberately cannot grant Settings access (that
// always requires the real admin login, since it holds integration
// credentials) - enforced in code, not just by omission from the Settings
// page's checkboxes.
model AccessLink {
  id        String   @id @default(cuid())
  name      String
  token     String   @unique
  sections  String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("access_links")
}
