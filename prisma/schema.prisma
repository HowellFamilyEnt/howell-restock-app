// Data model mirrors docs/PROJECT_SPEC.md section 4, which was validated
// against reference/Howell_Restock_Data_Model.xlsx. Keep field names in
// sync with that doc unless the user directs otherwise.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PropertyType {
  STR
  LTR
  HUD_VASH
}

enum PropertySource {
  Hostaway
  Manual
}

enum UserRole {
  Admin
  Field
}

enum NoteCategory {
  RestockIssue
  Repair
  General
}

enum NoteStatus {
  Open
  Resolved
}

enum WorkOrderStatus {
  Open
  Completed
  Archived
}

model Property {
  id                       String         @id @default(cuid())
  name_address             String
  address                  String?
  bedrooms                 Int?
  bathrooms                Float?
  master_door_code         String?
  // Internal-only - "Anything the crew or office should know," shown on
  // the property page's "Notes" card. Deliberately never sent to a guest
  // (src/lib/bookingConfirmation.ts) or shown on the guest portal
  // (src/app/guest/[token]/page.tsx) - the four fields below are the
  // guest-facing equivalent, kept as separate fields specifically so this
  // one never leaks into a guest-facing surface by accident.
  general_notes            String?
  // Guest-facing fields (src/app/guest/[token]/page.tsx) - all optional,
  // shown only when set.
  wifi_name                  String?
  wifi_password               String?
  guest_checkin_instructions String? // building + unit access, the multi-unit-complex case
  house_rules                 String?
  type                     PropertyType
  unit_count               Int
  assigned_cleaning_team   String?
  restock_frequency_days   Int
  urgent_restock_requested Boolean        @default(false)
  active                   Boolean        @default(true)
  // Raw airbnbExportStatus from Hostaway's listing (e.g. "exported" =
  // live/bookable on Airbnb right now) - captured for free during the
  // regular Hostaway sync (the bulk GET /v1/listings response already
  // includes it, confirmed live 2026-09-15, no extra API calls needed).
  // Null until the first sync after this field existed. Separate from
  // `active`, which is this app's own archive flag, not Hostaway's.
  airbnb_status            String?
  // IANA timezone name (e.g. "America/Chicago") from Hostaway's listing
  // timeZoneName - captured for free during the regular Hostaway sync
  // (confirmed live 2026-09-16, present on both the bulk and single-listing
  // endpoints). Needed to convert a reservation's checkInTime/checkOutTime
  // (bare local hours - see the comment on SCHEDULE_HOUR_UTC in
  // scheduling.ts) into a real UTC instant for Seam, which schedules real
  // hardware and can't tolerate the "just use a fixed UTC hour" shortcut
  // used elsewhere in this app for less time-critical scheduling.
  timezone                 String?
  hostaway_listing_id      String?        @unique
  source                   PropertySource @default(Manual)
  assignedTeamMemberId     String?
  // Crew-set Not ready/Ready state on the /cleaning/[token] page - a live
  // reservation covering today overrides this to "Occupied" for display
  // only (src/lib/cleaningStatus.ts), the stored value is untouched and
  // takes over again once the stay ends. Defaults every property to
  // "ready", which is an assumption about today's real-world state with
  // no way to verify from here - worth a one-time correction pass if
  // wrong for any property.
  cleaning_status          String         @default("ready")
  // The Seam device_id piloted on this property, if any - most properties
  // are null (not yet on smart access). Set from the live device list via
  // src/lib/seam.ts's listSeamLocks.
  smart_lock_id            String?
  // Per-property kill switch for anything guest-facing (direct booking
  // confirmation, smart-access codes) - checked alongside the global
  // IntegrationSettings.guest_automation_enabled switch by
  // sendBookingConfirmation/provisionGuestAccessCode. Defaults true (once
  // the global switch is on, a property participates unless explicitly
  // excluded) - the global switch, not this one, is the "nothing sends
  // yet" gate during testing.
  guest_automation_enabled Boolean        @default(true)
  // Free-form grouping label for the Properties page (src/app/(dashboard)/properties/page.tsx)
  // - e.g. a neighborhood or region. Purely organizational, derived groups
  // (like license_owner), no separate table - picking/typing a value on
  // any property creates or moves it into that group automatically.
  area                     String?

  // Short-term rental license tracking - independent of Hostaway (covers
  // LTR/HUD-VASH properties too, and doesn't depend on anyone remembering to
  // update Hostaway's own license fields). license_alert_sent_for records
  // the expiration_date value we last emailed a warning for, so the daily
  // check (src/lib/licenses.ts) sends one alert per license, not one per
  // day for the whole 60-day window - it's cleared to null wherever the
  // expiration date is updated.
  license_owner            String?
  license_number           String?
  license_type             String?
  license_issue_date       DateTime?
  license_expiration_date  DateTime?
  license_alert_sent_for   DateTime?
  // Stamped by syncLicensesToHostaway (src/lib/licenses.ts) whenever
  // license_number/license_expiration_date are confirmed to match this
  // property's Hostaway listing - either they already matched, or the
  // sync just pushed ours to make them match. Cleared back to null by
  // updateLicenseInfo whenever either of those fields is edited locally,
  // so a stale "confirmed" can never survive an unsynced change.
  license_hostaway_confirmed_at DateTime?

  parLevels            ParLevel[]
  restockEvents        RestockEvent[]
  notes                Note[]
  assignedUsers        User[]                @relation("AssignedProperties")
  assignedTeamMember   TeamMember?           @relation(fields: [assignedTeamMemberId], references: [id])
  workOrders           WorkOrder[]
  bookingConfirmations BookingConfirmation[]
  guestAccessCodes     GuestAccessCode[]
  checkinPhotos        CheckinPhoto[]
  upgradeRequests      UpgradeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("properties")
}

model Item {
  id                String   @id @default(cuid())
  name              String
  category          String
  unit_of_measure   String
  central_stock_qty Int      @default(0)
  reorder_threshold Int
  reorder_qty       Int
  preferred_vendor  String?
  unit_cost         Decimal  @db.Decimal(10, 2)
  active            Boolean  @default(true)
  // Which room(s) this item is grouped under in the property detail page's
  // par levels table and on work orders (admin + public) - separate from
  // `category` above, which is a general product taxonomy. An item can be
  // in more than one room (e.g. Hand Soap: Kitchen and Bathroom) - there's
  // still only one shared par level/quantity per property though, not one
  // per room it's grouped under. Empty means "Other" in the grouped UI.
  room_groups       String[] @default([])

  parLevels      ParLevel[]
  restockEvents  RestockEvent[]
  workOrderItems WorkOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("items")
}

model ParLevel {
  id          String @id @default(cuid())
  property_id String
  item_id     String
  target_qty  Int

  property Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([property_id, item_id])
  @@map("par_levels")
}

model RestockEvent {
  id             String   @id @default(cuid())
  property_id    String
  item_id        String
  date           DateTime
  qty_delivered  Int
  logged_by      String?
  logged_by_name String?
  urgent_flag    Boolean  @default(false)
  notes          String?

  property     Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  item         Item     @relation(fields: [item_id], references: [id], onDelete: Cascade)
  loggedByUser User?    @relation(fields: [logged_by], references: [id])

  createdAt DateTime @default(now())

  @@map("restock_events")
}

// Repair/issue notes, optionally tied to the work order visit they were
// spotted during (work_order_id) - always tied to a property either way.
// Completing a work order emails any of its notes (with photo links) to
// the service admin - see completeWorkOrderItem in src/lib/workorders.ts.
model Note {
  id            String       @id @default(cuid())
  property_id   String
  work_order_id String?
  date          DateTime
  category      NoteCategory
  description   String
  status        NoteStatus   @default(Open)

  property  Property    @relation(fields: [property_id], references: [id], onDelete: Cascade)
  workOrder WorkOrder?  @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  photos    NotePhoto[]

  createdAt DateTime @default(now())

  @@map("notes")
}

model NotePhoto {
  id      String @id @default(cuid())
  note_id String
  url     String

  note Note @relation(fields: [note_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("note_photos")
}

model TeamMember {
  id     String  @id @default(cuid())
  name   String
  email  String?
  phone  String?
  active Boolean @default(true)

  assignedProperties Property[]
  workOrders         WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// A snapshot task created for one property's upcoming restock visit. Line
// items (WorkOrderItem) copy each item's par level at creation time so the
// work order stays stable even if par levels change later. Reachable either
// by an authenticated admin (/work-orders/[id]) or via share_token, an
// unguessable link sent to the assigned team member with no login required
// (/wo/[token]) - see src/app/wo/[token]/page.tsx.
model WorkOrder {
  id                      String          @id @default(cuid())
  property_id             String
  assigned_team_member_id String?
  share_token             String          @unique
  status                  WorkOrderStatus @default(Open)
  scheduled_for           DateTime?
  sent_at                 DateTime?
  created_by              String?

  property           Property        @relation(fields: [property_id], references: [id], onDelete: Cascade)
  assignedTeamMember TeamMember?     @relation(fields: [assigned_team_member_id], references: [id])
  createdByUser      User?           @relation(fields: [created_by], references: [id])
  items              WorkOrderItem[]
  notes              Note[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("work_orders")
}

model WorkOrderItem {
  id            String    @id @default(cuid())
  work_order_id String
  item_id       String
  qty_needed    Int
  qty_on_site   Int?
  qty_added     Int?
  completed     Boolean   @default(false)
  completedAt   DateTime?

  workOrder WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@map("work_order_items")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  role          UserRole
  password_hash String

  assignedProperties Property[]     @relation("AssignedProperties")
  restockEvents      RestockEvent[]
  createdWorkOrders  WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Singleton row (id is always "hostaway") holding integration credentials
// entered via the Settings page. Not committed anywhere in source - this is
// the DB-backed alternative to the HOSTAWAY_ACCOUNT_ID / HOSTAWAY_API_KEY
// env vars, which still take precedence if set (see src/lib/settings.ts).
model IntegrationSettings {
  id                        String   @id @default("hostaway")
  hostaway_account_id       String?
  hostaway_api_key          String?
  // Basic Auth credentials Hostaway sends back on every webhook call,
  // entered here to match whatever's configured when the webhook is
  // registered in Hostaway's dashboard (Settings -> Integrations). Verified
  // by src/app/api/webhooks/hostaway/route.ts - that endpoint fails closed
  // (401) if these aren't set, unlike most other credentials here.
  hostaway_webhook_username String?
  hostaway_webhook_password String?
  // Master kill switch for every guest-facing automation (direct booking
  // confirmation, smart-access door codes) - defaults OFF so nothing
  // sends to a real guest until explicitly turned on here, letting
  // SuiteOp keep doing that job during testing. Checked by
  // sendBookingConfirmation and provisionGuestAccessCode before either
  // ever contacts a guest; Property.guest_automation_enabled is the
  // narrower per-property version of the same gate.
  guest_automation_enabled  Boolean  @default(false)
  seam_api_key              String?
  // Bot User OAuth Token (xoxb-...) from a Slack app with chat:write +
  // reactions:write, invited into the target channel - see
  // src/lib/slack.ts. slack_channel_id is that channel's ID (not name),
  // e.g. from "View channel details" in Slack.
  slack_bot_token           String?
  slack_channel_id          String?
  // Stripe keys for the upgrade-request flow (src/lib/stripe.ts) -
  // secret key used server-side, publishable key loaded client-side by
  // Stripe.js to render the card form. Use test-mode keys (sk_test_.../
  // pk_test_...) to verify this feature with zero real financial risk
  // before switching to live keys.
  stripe_secret_key         String?
  stripe_publishable_key    String?
  resend_api_key            String?
  resend_from_email         String?
  twilio_account_sid        String?
  twilio_auth_token         String?
  twilio_from_number        String?
  supabase_project_url      String?
  supabase_service_role_key String?
  service_admin_email       String?
  updatedAt                 DateTime @updatedAt

  @@map("integration_settings")
}

// Reusable defaults for creating a new Hostaway listing (src/app/(dashboard)/listings/new)
// - everything that's typically the same across properties (amenities,
// pricing defaults, cancellation policy, etc.), separate from the
// property-specific fields (address, bed/bath count, name) entered per
// listing. All nullable except name so a template can be saved partial.
model ListingTemplate {
  id                        String   @id @default(cuid())
  name                      String
  currency_code             String?
  price                     Decimal? @db.Decimal(10, 2)
  price_for_extra_person    Decimal? @db.Decimal(10, 2)
  guests_included           Int?
  cleaning_fee               Decimal? @db.Decimal(10, 2)
  refundable_damage_deposit Decimal? @db.Decimal(10, 2)
  cancellation_policy       String? // flexible / moderate / firm / strict / no_refund
  check_in_time_start       String? // "15:00" style
  check_in_time_end         String?
  check_out_time            String?
  min_nights                Int?
  max_nights                Int?
  instant_bookable          Boolean  @default(true)
  house_rules               String?
  amenity_ids               Int[]    @default([]) // Hostaway amenity ids, see fetchHostawayAmenities
  // Mail-merge text for the auto-filled description - supports
  // {bedrooms} {bathrooms} {city} {state} {amenities} placeholders,
  // filled in client-side (NewListingForm.tsx) when this template is
  // selected. No AI/external API involved.
  description_template      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("listing_templates")
}

// Records a guest booking-confirmation email/text sent directly by this app
// (src/lib/bookingConfirmation.ts), triggered by Hostaway's "reservation
// created" webhook (src/app/api/webhooks/hostaway/route.ts). Reservations
// aren't mirrored locally otherwise, so hostaway_reservation_id doubles as
// both the idempotency key (guards Hostaway's webhook retries) and, via
// email_sent/sms_sent/errors, the only record of whether a guest actually
// got their info - worth keeping even after the reservation itself is long
// in the past.
model BookingConfirmation {
  id                       String    @id @default(cuid())
  hostaway_reservation_id  String    @unique
  property_id              String?
  property                 Property? @relation(fields: [property_id], references: [id])
  guest_name               String?
  guest_email              String?
  guest_phone              String?
  arrival_date             DateTime?
  email_sent               Boolean   @default(false)
  sms_sent                 Boolean   @default(false)
  errors                   String?
  // No-login access control for the guest portal
  // (src/app/guest/[token]/page.tsx) - same role WorkOrder.share_token
  // plays for /wo/[token]. Generated once, the first time this row is
  // created, for every reservation regardless of whether a send actually
  // went out.
  share_token              String?   @unique
  // Cached here so the portal renders without a live Hostaway call,
  // mirroring how WorkOrder snapshots its line items rather than
  // re-fetching.
  departure_date           DateTime?
  check_in_hour            Int?
  check_out_hour           Int?
  confirmation_code        String?
  createdAt                DateTime  @default(now())

  @@map("booking_confirmations")
}

// Local cache of Seam's device list (src/lib/seamSync.ts's syncSeamLocks),
// grouped by manufacturer on the /locks admin page - refreshed on demand
// via that page's "Resync" button rather than on every page load, so
// property assignment (below) has something stable to point at and the
// page doesn't need to hit Seam's API just to render. Property assignment
// itself still lives on Property.smart_lock_id (the source of truth
// provisionGuestAccessCode/issueVendorAccessCode already read) - kept
// 1:1 by assignLock in src/app/(dashboard)/locks/actions.ts, which clears
// any other property pointing at the same device before setting a new one.
model SeamLock {
  id             String    @id @default(cuid())
  device_id      String    @unique
  manufacturer   String?
  display_name   String
  online         Boolean   @default(true)
  battery_level  Float?
  battery_status String?
  // User's own archive flag (hide-by-default, reversible) - separate from
  // `online`, which is Seam's live wifi status, and from `missing_since`
  // below, which is automatic. Mirrors Property.active.
  active         Boolean   @default(true)
  // Stamped by syncSeamLocks (src/lib/seamSync.ts) the first time a
  // resync no longer sees this device_id come back from Seam (renamed in
  // Kwikset/August/etc. still updates display_name normally - only a
  // real removal leaves it out of the response entirely). Cleared back to
  // null if the device reappears in a later sync. The row itself is never
  // auto-deleted, so an existing property assignment never silently
  // vanishes - this is the visible flag instead.
  missing_since  DateTime?
  lastSyncedAt   DateTime  @default(now())

  @@map("seam_locks")
}

// A Seam-issued door code for one reservation ("guest") or a one-off
// vendor visit like HVAC ("vendor"). Plays the same idempotency-log role
// BookingConfirmation plays for P1: hostaway_reservation_id doubles as
// the retry guard for guest codes (unique, null for vendor codes since
// those aren't reservation-triggered and there can be several per
// property). Time-bound codes and their backups self-revoke on Seam's
// side at ends_at - nothing here needs to actively revoke anything.
model GuestAccessCode {
  id                      String    @id @default(cuid())
  property_id             String
  property                Property  @relation(fields: [property_id], references: [id])
  hostaway_reservation_id String?   @unique
  purpose                 String // "guest" | "vendor"
  label                   String? // guest name, or a vendor label like "HVAC"
  seam_access_code_id     String?
  seam_backup_pulled_at   DateTime?
  code                    String?
  starts_at               DateTime?
  ends_at                 DateTime?
  status                  String? // Seam's display_status, cached
  error                   String?
  createdAt               DateTime  @default(now())

  @@map("guest_access_codes")
}

// One captioned step in the guest portal's "Building & unit access"
// walkthrough (src/app/guest/[token]/page.tsx) - e.g. a photo of the
// building entrance with "Enter through the north door." `order` is a
// plain integer, resequenced by swapping adjacent values when a step
// moves up/down (src/app/(dashboard)/properties/[id]/actions.ts) rather
// than reindexing the whole list.
model CheckinPhoto {
  id          String   @id @default(cuid())
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("checkin_photos")
}

// A guest's request for an upgrade (early check-in, late checkout, or an
// add-on), reviewed by the team over Slack (SuiteOp roadmap P4). One row
// per selection - a guest requesting both early check-in and an add-on
// creates two rows, two Slack posts, two independent approvals, matching
// how SuiteOp's own Slack message is one-upsell-per-message.
model UpgradeRequest {
  id                      String    @id @default(cuid())
  property_id             String
  property                Property  @relation(fields: [property_id], references: [id])
  hostaway_reservation_id String
  // No-login access control for the review page
  // (src/app/upgrade-review/[token]/page.tsx), same shape as
  // WorkOrder.share_token.
  share_token             String    @unique

  category           String // "early_checkin" | "late_checkout" | "addon"
  // Snapshot of the tier's label/price at request time
  // (src/lib/upgradeTiers.ts), so a later change to that file doesn't
  // rewrite the story of what this particular guest actually agreed to.
  tier_label          String
  price_cents         Int
  new_check_in_hour   Int? // set for category = early_checkin
  new_check_out_hour  Int? // set for category = late_checkout
  guest_note          String?
  guest_name          String?
  guest_email         String?

  stripe_customer_id       String?
  stripe_setup_intent_id   String?
  stripe_payment_method_id String?
  stripe_payment_intent_id String?

  // awaiting_payment_method -> pending -> approved | denied | payment_failed
  status           String    @default("awaiting_payment_method")
  slack_message_ts String?
  decided_by_name  String?
  decided_at       DateTime?
  error            String?
  createdAt        DateTime  @default(now())

  @@map("upgrade_requests")
}

// A shareable, no-login URL (/access/[token]) that grants whichever
// sections are listed in `sections` - see src/lib/accessLinks.ts for the
// canonical section list. Deliberately cannot grant Settings access (that
// always requires the real admin login, since it holds integration
// credentials) - enforced in code, not just by omission from the Settings
// page's checkboxes.
model AccessLink {
  id        String   @id @default(cuid())
  name      String
  token     String   @unique
  sections  String[]
  // Grants a second, separate no-login surface on the same token:
  // /cleaning/[token] (src/app/cleaning/[token]/page.tsx) - a single
  // chrome-less form (pick a property, note + photo, submit), independent
  // of `sections`/ACCESS_SECTIONS since it deliberately has no dashboard
  // nav tab. A link can have this on with an empty `sections` array (a
  // pure cleaning-crew link with no dashboard access at all).
  cleaning_enabled Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("access_links")
}
