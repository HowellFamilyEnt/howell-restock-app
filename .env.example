# Copy to .env.local AND .env (Prisma CLI only reads .env; Next.js reads both).
# Never commit either file - both are gitignored.
#
# Percent-encode any special characters in the DB password (e.g. @ -> %40)
# or the connection string will parse incorrectly.

# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase "Session pooler" (port 5432) - used for migrations/db push.
# The direct (non-pooler) connection is IPv6-only on Supabase's free tier and
# may not be reachable from every network - the session pooler works over IPv4.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js secret - generate with: openssl rand -base64 32
AUTH_SECRET=""

# Hostaway API (Settings -> Integrations -> API in your Hostaway dashboard).
# Never hardcode these in code - server-only, read via process.env.
HOSTAWAY_ACCOUNT_ID=""
HOSTAWAY_API_KEY=""

# Resend (email) and Twilio (SMS) for work order link notifications. Same
# env-var-wins-over-Settings-page pattern as Hostaway above.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Public base URL used to build shareable work order links (src/lib/workorders.ts).
APP_URL="http://localhost:3000"
